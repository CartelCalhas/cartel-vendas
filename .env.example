# Chave da API da Claude (console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=sk-ant-...

# Dados da instancia Chatwoot (BranorAI)
CHATWOOT_BASE_URL=https://chat.branorai.com
CHATWOOT_ACCOUNT_ID=2
# Profile Settings -> Access Token, dentro do Chatwoot
CHATWOOT_API_TOKEN=

# Token que so voce conhece, usado para validar que o webhook realmente
# veio do Chatwoot (configure a mesma string na URL do webhook, ex:
# https://seu-dominio.com/webhooks/chatwoot?secret=ESSE_TOKEN)
WEBHOOK_SECRET=troque-por-um-valor-aleatorio

# Senha das rotas administrativas (/reports/customers, /admin/pending-replies,
# /admin/prompt, /admin/errors). Usada como senha do HTTP Basic Auth que o
# navegador pede ao abrir essas paginas (usuario pode ser qualquer coisa,
# so a senha importa). Use um valor DIFERENTE do WEBHOOK_SECRET -- assim
# vazar um dos dois nao da acesso ao outro. Se deixar vazio, cai pro
# WEBHOOK_SECRET por compatibilidade, mas o recomendado e definir o seu.
ADMIN_SECRET=troque-por-outro-valor-aleatorio-diferente-do-webhook

# Se definido, o bot so responde mensagens dessa inbox (pegue o id em
# Settings -> Inboxes -> [inbox do WhatsApp] -> a URL mostra o id).
# Deixe vazio para responder em qualquer inbox.
CHATWOOT_INBOX_ID=

# Porta local do servidor
PORT=3000

# Quantas mensagens anteriores da conversa mandar como contexto pra Claude
HISTORY_LIMIT=15

# Coloque como "true" para pausar o robo (ele para de responder no WhatsApp
# ate voce remover essa variavel ou voltar pra "false"). Fica salvo aqui pra
# nao se perder se o servico reiniciar sozinho.
BOT_PAUSED=false

# Modelo da Claude usado em todas as chamadas (atendimento e relatorios).
CLAUDE_MODEL=claude-opus-5

# Pasta onde o servidor guarda estado local (jobs de relatorio em andamento,
# override do prompt de vendas). Criada automaticamente se nao existir.
DATA_DIR=data
